  (text "JP1 is an SPDT configuration switch: one throw selects direct unipolar MOD_RAW; the other selects MOD_BIPOLAR."
    (at 20 365 0)
    (effects
      (font
        (size 1.35 1.35))
      (justify left top))
    (uuid "7b4fd508-b5b2-5b07-a689-d7b3c79560be"))
  (text "JP1 pin 1 common to pin 2 selects MOD_BIPOLAR. Ideal Vout = 0.5*Vin + VREF25. -5/0/+5 V -> 0/2.5/5 V."
    (at 20 373 0)
    (effects
      (font
        (size 1.35 1.35))
      (justify left top))
    (uuid "80fe7b41-6f2a-594b-9af8-0ccef96fee07"))
  (text "5 V op-amp cannot reach exact rails under load. Endpoints, tolerance, saturation and calibration need testing."
    (at 20 381 0)
    (effects
      (font
        (size 1.35 1.35))
      (justify left top))
    (uuid "bfcafe52-723e-50e4-8f4c-e66cc98f2f45"))
  (text "Do not rescale the PITCH input implicitly. Bipolar MOD requires a matching firmware range/zero configuration."
    (at 20 389 0)
